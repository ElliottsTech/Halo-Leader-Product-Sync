# ─── Server ──────────────────────────────────────────────────────────────
PORT=9100
# Path prefix the app is served under. Set to '/Leader-Halo/' when behind a
# reverse proxy that routes by path; leave as '/' for root-mounted local dev.
BASE_PATH=/

# ─── Leader data feed ────────────────────────────────────────────────────
# Your Leader CustomerCode token (from the data-feed URL generator).
LEADER_CUSTOMER_CODE=your-leader-customer-code-here

# Refresh interval in hours (how often to re-download the catalogue).
LEADER_REFRESH_HOURS=6

# ─── Halo API ────────────────────────────────────────────────────────────
HALO_BASE_URL=https://your-halo-instance.com
HALO_CLIENT_ID=your-halo-client-id-here
HALO_CLIENT_SECRET=your-halo-client-secret-here

# ─── Storage ─────────────────────────────────────────────────────────────
# SQLite database file location (relative to project root).
DB_PATH=./data/catalogue.db

# ─── Halo custom fields ──────────────────────────────────────────────────
# Custom field ID for the Barcode field (from Halo Config → Custom Fields).
HALO_BARCODE_CF=409

# ─── QuickBooks Online syncing ────────────────────────────────────────────
# Enable QBO item linking (self-link + dropdown selector). Disable for users
# who don't use QuickBooks Online.
QBO_SYNC_ENABLED=true
QBO_COMPANY_ID=your-qbo-company-id-here

# ─── Edit password ────────────────────────────────────────────────────────
# Password required to unlock the margin/category-map tables for editing.
# Leave blank to disable editing entirely.
EDIT_PASSWORD=changeme
